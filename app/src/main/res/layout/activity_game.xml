<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="16dp"
    android:gravity="center_horizontal">

    <!-- شريط الحالة (النقاط والعودة ) - الجزء الذي يحل الأخطاء -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <!-- زر العودة (btn_back) - يحل خطأ btn_back -->
        <Button
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Back"
            android:backgroundTint="@color/primary"
            android:textColor="@color/text_on_primary"
            android:onClick="onBackClick" />

        <!-- مؤشر النقاط (text_score) - يحل خطأ text_score -->
        <TextView
            android:id="@+id/text_score"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0/5"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="end" />
    </LinearLayout>
    <!-- نهاية الجزء الذي يحل الأخطاء -->

    <!-- السؤال (يتم تحديثه برمجياً ) -->
    <TextView
        android:id="@+id/text_question"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/what_is_this_sound"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="32dp" />

    <!-- زر تشغيل الصوت -->
    <Button
        android:id="@+id/btn_play_sound"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="▶ Play Sound"
        android:textSize="18sp"
        android:textColor="@color/text_on_primary"
        android:backgroundTint="@color/primary"
        android:layout_marginBottom="40dp"
        android:padding="16dp"
        android:onClick="onPlaySoundClick" />

    <!-- خيارات الإجابة (GridLayout) -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="2"
        android:alignmentMode="alignMargins"
        android:columnOrderPreserved="false"
        android:layout_marginBottom="40dp">

        <!-- الخيار 1 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_option_1"
            android:layout_width="0dp"
            android:layout_height="150dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:onClick="onOptionSelected">

            <ImageView
                android:id="@+id/image_option_1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerInside"
                android:padding="16dp"
                android:src="@drawable/ic_bell"
                android:contentDescription="@string/sound_picture_match" />
        </androidx.cardview.widget.CardView>

        <!-- الخيار 2 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_option_2"
            android:layout_width="0dp"
            android:layout_height="150dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:onClick="onOptionSelected">

            <ImageView
                android:id="@+id/image_option_2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerInside"
                android:padding="16dp"
                android:src="@drawable/ic_rain"
                android:contentDescription="@string/sound_picture_match" />
        </androidx.cardview.widget.CardView>

        <!-- الخيار 3 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_option_3"
            android:layout_width="0dp"
            android:layout_height="150dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:onClick="onOptionSelected">

            <ImageView
                android:id="@+id/image_option_3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerInside"
                android:padding="16dp"
                android:src="@drawable/ic_car"
                android:contentDescription="@string/sound_picture_match" />
        </androidx.cardview.widget.CardView>

        <!-- الخيار 4 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_option_4"
            android:layout_width="0dp"
            android:layout_height="150dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:onClick="onOptionSelected">

            <ImageView
                android:id="@+id/image_option_4"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerInside"
                android:padding="16dp"
                android:src="@drawable/ic_lion"
                android:contentDescription="@string/sound_picture_match" />
        </androidx.cardview.widget.CardView>

    </GridLayout>

    <!-- زر التالي (يظهر بعد الإجابة) -->
    <Button
        android:id="@+id/btn_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/next"
        android:textSize="18sp"
        android:textColor="@color/text_on_primary"
        android:backgroundTint="@color/secondary"
        android:layout_marginBottom="16dp"
        android:padding="16dp"
        android:onClick="onNextClick"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- زر العودة -->
    <Button
        android:id="@+id/btn_back_to_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/back_to_main"
        android:textSize="16sp"
        android:textColor="@color/text_on_primary"
        android:backgroundTint="@color/primary_dark"
        android:padding="12dp"
        android:onClick="onBackToMainClick" />

</LinearLayout>
